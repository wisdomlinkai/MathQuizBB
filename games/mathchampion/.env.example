# AWS Configuration
# Copy this file to .env and fill in the values from your CDK deployment

# Cognito Configuration
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=math-champions.auth.us-east-1.amazoncognito.com
VITE_AWS_REGION=us-east-1

# API Gateway
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# CloudFront (optional - for production)
VITE_CLOUDFRONT_URL=https://xxxxxxxxxxxx.cloudfront.net

# Feature Flags
VITE_USE_AWS_BACKEND=true
VITE_OFFLINE_MODE=false
VITE_ENABLE_ANALYTICS=false
